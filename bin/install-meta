#!/usr/bin/env perl

use strict;
use warnings;

use DBI;
use DBD::Pg;
use Text::CSV;

our $VALIDATION_ERROR_CODE = 99;
our $dbh;

my @ENV_VARS = ('DB_HOST', 'DB_PORT', 'DB_NAME', 'DB_USER', 'DB_PASS', 'DB_SCHEMA');

END { $dbh->disconnect() if $dbh }

run();

# ---------------------------------------------------------------------------

sub run {
  my ($userDatasetId, $metaJsonFile, $propsFileDir) = @ARGV;

  usage() unless scalar(@ARGV) == 3;

  for my $var (@ENV_VARS) {
    die "Missing env variable '$var'" unless $ENV{$var};
  }

  my ($propsFilePath) = find_props_file($propsFileDir);

  # Nothing to do if no properties file was provided
  exit 0 unless defined $propsFilePath;

  db_connect();

  my ($tableName, $entityId) = find_table_name($userDatasetId);

  my ($props, $varNames) = parse_props_file($propsFilePath);

  print STDERR "Parsed " . scalar(@$props) . " properties from $propsFilePath\n";

  validate_variables($tableName, $props, $varNames);
  update_metadata($tableName, $props, $userDatasetId, $entityId);
}

# ---------------------------------------------------------------------------

sub db_connect {
  $dbh = DBI->connect(
    "dbi:Pg:host=$ENV{DB_HOST};port=$ENV{DB_PORT};dbname=$ENV{DB_NAME}",
    $ENV{DB_USER},
    $ENV{DB_PASS},
    { RaiseError => 1, AutoCommit => 0 }
  ) or die "Could not connect to database: " . DBI->errstr;
}

# ---------------------------------------------------------------------------
# Returns the fully-qualified attributegraph table name for this dataset.
# Queries study + entitytypegraph to resolve both abbreviations.

sub find_table_name {
  my ($userDatasetId) = @_;

  my $schema = $ENV{DB_SCHEMA};

  my $sql = "
    SELECT s.internal_abbrev AS study_abbrev,
           e.internal_abbrev AS entity_abbrev,
           e.stable_id AS entity_id
    FROM   $schema.study s
    JOIN   $schema.entitytypegraph e
           ON e.study_stable_id = s.stable_id
    WHERE  s.user_dataset_id = ?
  ";

  my $sth = $dbh->prepare($sql);
  $sth->execute($userDatasetId);

  my @rows;
  while (my $row = $sth->fetchrow_hashref()) {
    push @rows, $row;
  }
  $sth->finish();

  validationError("No study/entity found for dataset '$userDatasetId'")
    if scalar(@rows) == 0;

  validationError("Multiple entities found for dataset '$userDatasetId'; multi-entity datasets not yet supported")
    if scalar(@rows) > 1;

  my ($studyAbbrev, $entityAbbrev, $entityId) = ($rows[0]->{study_abbrev}, $rows[0]->{entity_abbrev}, $rows[0]->{entity_id});
  return ("$schema.attributegraph_${studyAbbrev}_${entityAbbrev}", $entityId);
}

# ---------------------------------------------------------------------------
# Returns the path of the single file in $dir, or undef if the dir is empty.
# Exits with a validation error if more than one file is present.

sub find_props_file {
  my ($dir) = @_;

  die "Directory '$dir' does not exist" unless -d $dir;

  opendir(my $dh, $dir) or die "Cannot open directory '$dir': $!";
  my @files = grep { -f "$dir/$_" && $_ !~ /^\./ } readdir($dh);
  closedir($dh);

  return undef if scalar(@files) == 0;

  validationError("Expected only one variable mapping file, found " . scalar(@files))
    unless scalar(@files) == 1;

  return ("$dir/$files[0]", $files[0]);
}

# ---------------------------------------------------------------------------
# Mirrors study-wrangler's detect_file_encoding() in R: probe for valid UTF-8;
# if invalid, distinguish Windows-1252 (bytes 0x80-0x9F present, which are
# printable in that encoding) from ISO-8859-1 (those bytes are control codes).

sub detect_file_encoding {
  my ($path) = @_;
  open(my $fh, '<:raw', $path) or die "Cannot open '$path': $!";
  my $bytes = do { local $/; <$fh> };
  close($fh);
  my $test = $bytes;
  return 'UTF-8' if utf8::decode($test);
  return ($bytes =~ /[\x80-\x9F]/) ? 'Windows-1252' : 'ISO-8859-1';
}

# ---------------------------------------------------------------------------
# Parses the properties file, returning an arrayref of hashrefs with keys
# stable_id, display_name, definition.
#
# Accepts .csv (comma-delimited) or anything else (tab-delimited).
# Locates columns by header name (variable, label, definition) in any order.

sub parse_props_file {
  my ($path) = @_;

  my $delim = ($path =~ /\.csv$/i) ? ',' : "\t";

  my $csv = Text::CSV->new({
    sep_char  => $delim,
    binary    => 1,
    auto_diag => 1,
  });

  validationError("File exceeds the 1M size limit") if -s $path > 1000000;

  my $enc = detect_file_encoding($path);
  open(my $fh, "<:encoding($enc)", $path) or die "Cannot open '$path': $!";

  # Locate the header row (skip blank lines and comments)
  my $col_idx;
  while (my $row = $csv->getline($fh)) {
    next if join('', @$row) =~ /^\s*$/;        # blank
    next if $row->[0] =~ /^\s*#/;              # comment

    my %idx;
    for my $i (0 .. $#$row) {
      my $name = lc($row->[$i]);
      $name =~ s/^\s+|\s+$//g;
      $idx{$name} = $i;
    }

    for my $required (qw(variable label definition)) {
      validationError("Missing required column '$required'")
        unless exists $idx{$required};
    }

    $col_idx = \%idx;
    last;
  }

  validationError("Appears to be empty or contains only comments")
    unless defined $col_idx;

  # Read data rows
  my @props;
  my %seen;
  my $count = 1;

  while (my $row = $csv->getline($fh)) {
    $count += 1;
    next if join('', @$row) =~ /^\s*$/;
    next if $row->[0] =~ /^\s*#/;

    my $variableName = $row->[$col_idx->{variable}];
    my $displayName  = $row->[$col_idx->{label}];
    my $definition   = $row->[$col_idx->{definition}] || undef;

    validationError("Line $count is missing either the variable or label: " . join(', ', @$row)) unless $variableName && $displayName;

    $variableName =~ s/^\s+|\s+$//g;
    next unless length($variableName);

    if (exists $seen{$variableName}) {
      close($fh);
      validationError("Duplicate variable '$variableName'");
    }
    $seen{$variableName} = 1;

    push @props, {
      variable_name => $variableName,
      display_name  => $displayName,
      definition    => $definition,
    };
  }

  close($fh);
  return (\@props, \%seen);
}

# ---------------------------------------------------------------------------
# Validates that db variables and annotation file variables agree.
#
# Ignores geoaggregator variables that we generate on import.
sub validate_variables {
  my ($tableName, $props, $varNames) = @_;

  my $sth = $dbh->prepare(
    qq{
        SELECT
            provider_label::jsonb ->> 0 AS provider_label
        FROM
            $tableName
        WHERE
            display_type IS DISTINCT FROM 'geoaggregator'
    } # get first element of JSON array; allow NULL display_type
  );

  $sth->execute();
  my %dbVars;
  while (my ($providerLabel) = $sth->fetchrow_array()) {
    $dbVars{$providerLabel} = 1;
  }
  $sth->finish();

  my @missingVars;
  foreach my $dbVar (keys %dbVars) {
    push(@missingVars, $dbVar) unless $varNames->{$dbVar};
  }
  my @extraVars;
  foreach my $var (keys %$varNames) {
    push(@extraVars, $var) unless $dbVars{$var};
  }

  my $missingMsg = @missingVars? " Missing variables [" . join(', ', @missingVars) . "]." : "";
  my $extraMsg = @missingVars? " Extra variables [" . join(', ', @extraVars) . "]." : "";
  validationError($missingMsg . $extraMsg) if $missingMsg or $extraMsg;

}

# ---------------------------------------------------------------------------
# Updates display_name and definition for each entry in $props.

sub update_metadata {
  my ($tableName, $props, $userDatasetId, $entityId) = @_;

  # update the study-specific attributegraph table
  my $sth = $dbh->prepare(
    "UPDATE $tableName SET display_name = ?, definition = ? WHERE provider_label::jsonb \\?| ARRAY[?]"
  );

  # Update the shared Variable table with display_name and definition for each property
  my $varSql = "
UPDATE $ENV{DB_SCHEMA}.variable SET display_name = ?, definition = ?
 WHERE provider_label::jsonb \\?| ARRAY[?]
  AND dataset_id = '$userDatasetId'
  AND entity_stable_id = '$entityId'
";

  my $sth2 = $dbh->prepare($varSql);

  for my $prop (@$props) {
    $sth->execute($prop->{display_name}, $prop->{definition}, $prop->{variable_name});
    $sth2->execute($prop->{display_name}, $prop->{definition}, $prop->{variable_name});
  }
  $sth->finish();
  $sth2->finish();

  $dbh->commit();

  print STDERR "Successfully updated " . scalar(@$props) . " records in $tableName and $ENV{DB_SCHEMA}.variable\n";
}

# ---------------------------------------------------------------------------

sub validationError {
  my ($message) = @_;
  print "Invalid annotation file: " . "$message\n";
  exit $VALIDATION_ERROR_CODE;
}

sub usage {
  my $envStr = '$' . join(", \$", @ENV_VARS);

  die "
Install metadata for a VDI user dataset.

Usage: install-meta user_dataset_id meta.json propsfiledir

Where:
  user_dataset_id:  a VDI user dataset id
  meta.json:        metadata JSON file (currently ignored)
  propsfiledir:     directory containing zero or one variable annotations file

The annotations file may be .csv (comma-delimited) or .tsv/.txt (tab-delimited).
It must have a header row with columns named: variable, label, definition
Columns may appear in any order. Comments (#) and blank lines are ignored.

Updates the attributegraph table with the label (display_name) and definition
of each variable listed. Ignores meta.json.

Env: $envStr

";
}
