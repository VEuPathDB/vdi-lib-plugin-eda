#!/usr/bin/env perl

use strict;
use warnings;

use DBI;
use DBD::Pg;
use Text::CSV;

our $VALIDATION_ERROR_CODE = 99;
our $dbh;

my @ENV_VARS = ('DB_HOST', 'DB_PORT', 'DB_NAME', 'DB_USER', 'DB_PASS', 'DB_SCHEMA');

END { $dbh->disconnect() if $dbh }

run();

# ---------------------------------------------------------------------------

sub run {
  my ($userDatasetId, $metaJsonFile, $propsFileDir) = @ARGV;

  usage() unless scalar(@ARGV) == 3;

  for my $var (@ENV_VARS) {
    validationError("Missing env variable '$var'") unless $ENV{$var};
  }

  my $propsFile = find_props_file($propsFileDir);

  # Nothing to do if no properties file was provided
  exit 0 unless defined $propsFile;

  db_connect();

  my $tableName = find_table_name($userDatasetId);

  my $props = parse_props_file($propsFile);

  print STDERR "Parsed " . scalar(@$props) . " properties from $propsFile\n";

  validate_variables($tableName, $props);
  update_metadata($tableName, $props);
}

# ---------------------------------------------------------------------------

sub db_connect {
  $dbh = DBI->connect(
    "dbi:Pg:host=$ENV{DB_HOST};port=$ENV{DB_PORT};dbname=$ENV{DB_NAME}",
    $ENV{DB_USER},
    $ENV{DB_PASS},
    { RaiseError => 1, AutoCommit => 0 }
  ) or die "Could not connect to database: " . DBI->errstr;
}

# ---------------------------------------------------------------------------
# Returns the fully-qualified attributegraph table name for this dataset.
# Queries study + entitytypegraph to resolve both abbreviations.

sub find_table_name {
  my ($userDatasetId) = @_;

  my $schema = $ENV{DB_SCHEMA};

  my $sql = "
    SELECT s.internal_abbrev AS study_abbrev,
           e.internal_abbrev AS entity_abbrev
    FROM   $schema.study s
    JOIN   $schema.entitytypegraph e
           ON e.study_stable_id = s.stable_id
    WHERE  s.user_dataset_id = ?
  ";

  my $sth = $dbh->prepare($sql);
  $sth->execute($userDatasetId);

  my @rows;
  while (my $row = $sth->fetchrow_hashref()) {
    push @rows, $row;
  }
  $sth->finish();

  validationError("No study/entity found for dataset '$userDatasetId'")
    if scalar(@rows) == 0;

  validationError("Multiple entities found for dataset '$userDatasetId'; multi-entity datasets not yet supported")
    if scalar(@rows) > 1;

  my ($studyAbbrev, $entityAbbrev) = ($rows[0]->{study_abbrev}, $rows[0]->{entity_abbrev});
  return "$schema.attributegraph_${studyAbbrev}_${entityAbbrev}";
}

# ---------------------------------------------------------------------------
# Returns the path of the single file in $dir, or undef if the dir is empty.
# Exits with a validation error if more than one file is present.

sub find_props_file {
  my ($dir) = @_;

  validationError("Directory '$dir' does not exist") unless -d $dir;

  opendir(my $dh, $dir) or die "Cannot open directory '$dir': $!";
  my @files = grep { -f "$dir/$_" && $_ !~ /^\./ } readdir($dh);
  closedir($dh);

  return undef if scalar(@files) == 0;

  validationError("Expected only one variable mapping file, found " . scalar(@files))
    unless scalar(@files) == 1;

  return "$dir/$files[0]";
}

# ---------------------------------------------------------------------------
# Parses the properties file, returning an arrayref of hashrefs with keys
# stable_id, display_name, definition.
#
# Accepts .csv (comma-delimited) or anything else (tab-delimited).
# Locates columns by header name (variable, label, definition) in any order.

sub parse_props_file {
  my ($path) = @_;

  my $delim = ($path =~ /\.csv$/i) ? ',' : "\t";

  my $csv = Text::CSV->new({
    sep_char  => $delim,
    binary    => 1,
    auto_diag => 1,
  });

  open(my $fh, '<:encoding(utf8)', $path) or die "Cannot open '$path': $!";

  # Locate the header row (skip blank lines and comments)
  my $col_idx;
  while (my $row = $csv->getline($fh)) {
    next if join('', @$row) =~ /^\s*$/;        # blank
    next if $row->[0] =~ /^\s*#/;              # comment

    my %idx;
    for my $i (0 .. $#$row) {
      my $name = lc($row->[$i]);
      $name =~ s/^\s+|\s+$//g;
      $idx{$name} = $i;
    }

    for my $required (qw(variable label definition)) {
      validationError("Properties file '$path' is missing required column '$required'")
        unless exists $idx{$required};
    }

    $col_idx = \%idx;
    last;
  }

  validationError("Properties file '$path' appears to be empty or contains only comments")
    unless defined $col_idx;

  # Read data rows
  my @props;
  my %seen;

  while (my $row = $csv->getline($fh)) {
    next if join('', @$row) =~ /^\s*$/;
    next if $row->[0] =~ /^\s*#/;

    my $stableId    = $row->[$col_idx->{variable}]    // '';
    my $displayName = $row->[$col_idx->{label}]       // '';
    my $definition  = $row->[$col_idx->{definition}]  // '';

    $stableId =~ s/^\s+|\s+$//g;
    next unless length($stableId);

    if (exists $seen{$stableId}) {
      close($fh);
      validationError("Duplicate variable '$stableId' in properties file");
    }
    $seen{$stableId} = 1;

    push @props, {
      stable_id    => $stableId,
      display_name => $displayName,
      definition   => $definition,
    };
  }

  close($fh);
  return \@props;
}

# ---------------------------------------------------------------------------
# Validates that every stable_id in $props exists in the attributegraph table.

sub validate_variables {
  my ($tableName, $props) = @_;

  my $sth = $dbh->prepare("SELECT stable_id FROM $tableName");
  $sth->execute();

  my %existing;
  while (my ($id) = $sth->fetchrow_array()) {
    $existing{$id} = 1;
  }
  $sth->finish();

  for my $prop (@$props) {
    validationError("variable '$prop->{stable_id}' not found in dataset's data files")
      unless exists $existing{$prop->{stable_id}};
  }
}

# ---------------------------------------------------------------------------
# Updates display_name and definition for each entry in $props.

sub update_metadata {
  my ($tableName, $props) = @_;

  my $sth = $dbh->prepare(
    "UPDATE $tableName SET display_name = ?, definition = ? WHERE stable_id = ?"
  );

  for my $prop (@$props) {
    $sth->execute($prop->{display_name}, $prop->{definition}, $prop->{stable_id});
  }
  $sth->finish();

  $dbh->commit();

  print STDERR "Successfully updated " . scalar(@$props) . " records in $tableName\n";
}

# ---------------------------------------------------------------------------

sub validationError {
  my ($message) = @_;
  print "$message\n";
  exit $VALIDATION_ERROR_CODE;
}

sub usage {
  my $envStr = '$' . join(", \$", @ENV_VARS);

  die "
Install metadata for a VDI user dataset.

Usage: install-meta user_dataset_id meta.json propsfiledir

Where:
  user_dataset_id:  a VDI user dataset id
  meta.json:        metadata JSON file (currently ignored)
  propsfiledir:     directory containing zero or one variable annotations file

The annotations file may be .csv (comma-delimited) or .tsv/.txt (tab-delimited).
It must have a header row with columns named: variable, label, definition
Columns may appear in any order. Comments (#) and blank lines are ignored.

Updates the attributegraph table with the label (display_name) and definition
of each variable listed. Ignores meta.json.

Env: $envStr

";
}
